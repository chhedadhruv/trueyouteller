# Copy to .env and fill in. All values are public client config (bundled into the site).

# Firebase (Firestore + Hosting)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Google Analytics 4 (Firebase console > Project settings > Integrations > Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=
# Set to true to send analytics from `yarn dev` (shows in GA4 DebugView)
VITE_ANALYTICS_DEBUG=
# Optional: reCAPTCHA v3 site key for Firebase App Check (blocks spam writes)
VITE_RECAPTCHA_SITE_KEY=
# Optional, local only: use the Firestore emulator, e.g. localhost:8085
VITE_FIRESTORE_EMULATOR=

# EmailJS (contact + feedback forms)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_FEEDBACK_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
