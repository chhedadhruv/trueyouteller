{
  "name": "trueyouteller",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "images:optimize": "node scripts/optimize-images.mjs",
    "og:generate": "node scripts/generate-og.mjs",
    "deploy": "yarn build && firebase deploy --only hosting",
    "test": "node --test \"src/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-trueyouteller \"\"$npm_node_execpath\" --test tests/firestore.rules.test.js\""
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@react-router/node": "^7.9",
    "canvas-confetti": "^1.9.4",
    "firebase": "^11.9.0",
    "isbot": "^5.2.2",
    "jspdf": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "react-icons": "^5.5.0",
    "react-router": "^7.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@react-router/dev": "^7.9",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "satori": "^0.33.5",
    "sharp": "^0.35.5",
    "vite": "^6.3.5"
  }
}
